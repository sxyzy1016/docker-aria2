FROM alpine:latest AS builder

WORKDIR /

RUN apk add --no-cache curl wget unzip && \
    LATEST_VERSION=$(curl -s "https://api.github.com/repos/mayswind/AriaNg/releases" | awk '/tag_name/{print $4;exit}' FS='[""]') && \
    wget "https://github.com/mayswind/AriaNg/releases/download/${LATEST_VERSION}/AriaNg-${LATEST_VERSION}.zip" -O ariang.zip

RUN mkdir AriaNg && unzip ariang.zip -d AriaNg

FROM p3terx/ariang:latest

COPY --from=builder /AriaNg/ /AriaNg/
